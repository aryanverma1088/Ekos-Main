# Copy this file to .env and fill in real values. Never commit .env itself.

# SQLite path (relative to backend working dir)
DATABASE_URL=sqlite:///../data/processed/ekos.db

# Local LLM (used for extraction/reasoning only — retrieval never depends on this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# If unset, EKOS runs in "IR-only" mode: search/BM25/dense/hybrid/rerank all work,
# but knowledge-graph extraction and LLM-assisted contradiction reasoning are skipped.
LLM_ENABLED=false
